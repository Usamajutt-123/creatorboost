# ============================================================
# CreatorBoost — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- Supabase (required) ---
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Used for metadata, sitemap, canonical URLs.
NEXT_PUBLIC_SITE_URL=https://creatorboost.io

# --- Support ---
# Public-facing support email shown across the site.
NEXT_PUBLIC_SUPPORT_EMAIL=support@creatorboost.io
# Optional: webhook that /api/support forwards tickets to (e.g. Resend / Slack).
SUPPORT_EMAIL_WEBHOOK_URL=

# --- IP -> Country (optional, server-side) ---
# If unset, unknown countries resolve to a safe low-tier CPM (never highest).
# IP_GEO_MOCK_COUNTRY=US        # dev/test only: force a country
# IP_GEO_SERVICE_URL=https://geo.example.com/lookup
# IP_GEO_SERVICE_TOKEN=

# --- Fraud (optional) ---
# Set to "true" to invoke the deployed `fraud-check` Supabase Edge Function.
# When disabled/unavailable, local server-side heuristics are used and the
# system fails safe (conservative) rather than awarding premium earnings.
SUPABASE_FRAUD_FN_ENABLED=false

# --- Cron / scheduler ---
# Secret header value for POST /api/cron/release-earnings (earnings release).
CRON_SECRET=
