# ============================================================
# CreatorBoost — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env / .env.local / service-role keys / API keys.
# ============================================================

# --- Supabase (required) ---
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Used for metadata, sitemap, canonical URLs and email links.
NEXT_PUBLIC_SITE_URL=https://creatorboost.io

# --- Support ---
# Public-facing support email shown across the site and in emails.
NEXT_PUBLIC_SUPPORT_EMAIL=support@creatorboost.io
# Optional: webhook that /api/support forwards tickets to (e.g. Slack).
SUPPORT_EMAIL_WEBHOOK_URL=

# --- IP -> Country (optional, server-side) ---
# Provider selection. Never trust the browser for country.
#   IP_GEO_PROVIDER=ipwhois  -> keyless https://ipwho.is (privacy-conscious, recommended)
#   IP_GEO_PROVIDER=ipapi    -> https://ipapi.co (optional token below)
#   IP_GEO_PROVIDER=http     -> any service implementing GET {IP_GEO_SERVICE_URL}?ip=<ip>
#                               returning JSON { countryCode: "US" } (or {country})
# If unset, unknown/private IPs resolve to a safe low-tier CPM (never highest).
IP_GEO_PROVIDER=
IP_GEO_SERVICE_URL=
IP_GEO_SERVICE_TOKEN=
# Dev/test only: force a country code (e.g. US). NEVER set in production.
# IP_GEO_MOCK_COUNTRY=US

# --- Fraud (optional) ---
# Set to "true" to invoke the deployed `fraud-check` Supabase Edge Function
# (which may call IPQualityScore). When disabled/unavailable, local
# server-side heuristics are used and the system fails safe (conservative)
# rather than awarding premium earnings.
SUPABASE_FRAUD_FN_ENABLED=false
# Optional: IPQualityScore API key for the fraud-check edge function.
IPQUALITYSCORE_KEY=

# --- Email (Resend) ---
# Required to send transactional emails (welcome, withdrawals, support).
# When unset, email sending is skipped gracefully (no fake "sent" claims).
RESEND_API_KEY=
# Sender address, e.g. "CreatorBoost <no-reply@yourdomain.com>"
EMAIL_FROM=CreatorBoost <no-reply@creatorboost.io>
# Support address used inside emails.
SUPPORT_EMAIL=support@creatorboost.io
# NOTE: email-verification and password-reset emails are sent by Supabase
# Auth itself — configure SMTP/Resend under Supabase Auth settings.

# --- Cron / scheduler ---
# Secret header value for POST /api/cron/release-earnings (earnings release).
# Call with header `x-cron-secret: <value>` from Vercel Cron / GitHub Actions.
CRON_SECRET=

# --- Ad revenue (optional) ---
# Until a real provider endpoint is configured, the admin panel shows
# "Revenue integration not configured" and revenue can only be recorded
# manually (labeled MANUAL). Never fabricate revenue.
# ADSTERRA_API_URL=
# ADSTERRA_API_TOKEN=
# MONETAG_API_URL=
# MONETAG_API_TOKEN=
